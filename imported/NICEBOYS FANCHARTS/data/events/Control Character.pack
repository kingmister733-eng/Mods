Control Character.hx________PACKSEP________function onEvent(event) {
    if (event.event.name == "Control Character") {

        var target = strumLines.members[event.event.params[0]].characters[event.event.params[1]];

        var xPos:Float = event.event.params[2];
        var yPos:Float = event.event.params[3];
        var alpha:Float = event.event.params[4];

        var moveMode:String = event.event.params[5];
        var doTween:Bool = event.event.params[6];
        var tweenTime:Float = event.event.params[7];

        var flipX:Bool = event.event.params[8];
        var flipY:Bool = event.event.params[9];
        var angle:Float = event.event.params[10];

        // Aplicar alpha
        target.alpha = alpha;

        // Aplicar flip y rotación
        target.flipX = flipX;
        target.flipY = flipY;
        target.angle = angle;

        // Calcular posiciones finales
        if(moveMode != "Dont Move"){
        var finalX = (moveMode == "Absolute") ? xPos : target.x + xPos;
        var finalY = (moveMode == "Absolute") ? yPos : target.y + yPos;
        

        if (doTween) {
            FlxTween.tween(target, {x: finalX, y: finalY}, tweenTime);
        } else {
            target.x = finalX;
            target.y = finalY;
        }
    }
}


}
________PACKSEP________{
  "params": [
    {
      "name": "StrumLine Index",
      "type": "StrumLine",
      "defaultValue": "0"
    },
        {
      "name": "Character in strumline",
      "type": "Float(0, 100, 1, 2)",
      "defaultValue": "0"
    },
    {
      "name": "X Position",
      "type": "Float(-10000, 10000, 1, 2)",
      "defaultValue": "0"
    },
    {
      "name": "Y Position",
      "type": "Float(-10000, 10000, 1, 2)",
      "defaultValue": "0"
    },
    {
      "name": "Alpha",
      "type": "Float(0, 1, 0.01, 2)",
      "defaultValue": "1"
    },
    {
      "name": "Move Mode",
      "type": "DropDown('Dont Move','Absolute', 'Relative')",
      "defaultValue": "Dont Move"
    },
    {
      "name": "Tween?",
      "type": "Bool",
      "defaultValue": "false"
    },
    {
      "name": "Tween Time",
      "type": "Float(0, 100, 0.1, 2)",
      "defaultValue": "1"
    },
    {
      "name": "Flip X",
      "type": "Bool",
      "defaultValue": "false"
    },
    {
      "name": "Flip Y",
      "type": "Bool",
      "defaultValue": "false"
    },
    {
      "name": "Angle",
      "type": "Float(-360, 360, 1, 2)",
      "defaultValue": "0"
    }
  ]
}
________PACKSEP________