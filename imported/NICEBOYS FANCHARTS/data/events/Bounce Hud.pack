Bounce Hud.hx________PACKSEP________var bounce:Bool = false;
var elapsedAdd:Float = 0;
var distanceY:Float = 5;

var fallingSpeed:Float = 3;
var speedY:Float = 1;

var bpmToFollow = Conductor.bpm/10;
function postUpdate(elapsed) {
    if(bounce) {
        elapsedAdd += elapsed;
        speedY += elapsed*(bpmToFollow*5);

        camHUD.y += (fallingSpeed*speedY)*elapsed;
        if(camHUD.y >= 0) speedY = -30;

        camHUD.angle = Math.cos(elapsedAdd * bpmToFollow / distanceY / 2) * distanceY / 2;
        camGame.angle = Math.cos(elapsedAdd * 2 / (distanceY / 2)) * (distanceY / 2);
    } else {
        camHUD.angle = FlxMath.lerp(camHUD.angle, 0, elapsed);
        camGame.angle = FlxMath.lerp(camGame.angle, 0, elapsed);
        camHUD.y = FlxMath.lerp(camHUD.y, 0, elapsed);
    }
}

function onEvent(e) if(e.event.name == 'Bounce Hud') {
    bounce = e.event.params[0];
    bpmToFollow = Conductor.bpm/10;
}________PACKSEP________{
    "params": [
        {
            "name": "Bounce?",
            "type": "Bool",
            "defaultValue": false
        }
    ]
}________PACKSEP________