Move Strumline.hx________PACKSEP________import flixel.tweens.FlxTween;
import flixel.tweens.FlxEase;

function onEvent(event)
{
    if (event.event.name == "Move Strumline")
    {
        var targetStrumline = strumLines.members[event.event.params[0]];

        var xPos:Float = event.event.params[1];
        var yPos:Float = event.event.params[2];
        var alpha:Float = event.event.params[3];

        var moveMode:String = event.event.params[4];
        var doTween:Bool = event.event.params[5];
        var tweenTime:Float = event.event.params[6];

        var tweenType:String = event.event.params[7];
        var tweenDirection:String = event.event.params[8];

        var flipX:Bool = event.event.params[9];
        var flipY:Bool = event.event.params[10];
        var angle:Float = event.event.params[11];

        var chosenEase = CoolUtil.flxeaseFromString(tweenType, tweenDirection);

        for(note in targetStrumline.members)
        {
            note.alpha = alpha;

            note.flipX = flipX;
            note.flipY = flipY;

            note.angle = angle;

            if(moveMode != "Dont Move")
            {
                var finalX = (moveMode == "Absolute") ? xPos : note.x + xPos;
                var finalY = (moveMode == "Absolute") ? yPos : note.y + yPos;

                if (doTween)
                {
                    FlxTween.cancelTweensOf(note);

                    FlxTween.tween(note,
                    {
                        x: finalX,
                        y: finalY
                    },
                    tweenTime,
                    {
                        ease: chosenEase
                    });
                }
                else
                {
                    note.x = finalX;
                    note.y = finalY;
                }
            }
        }
    }
}________PACKSEP________{
  "params": [
    {
      "name": "StrumLine Index",
      "type": "StrumLine",
      "defaultValue": "0"
    },
    {
      "name": "X Position",
      "type": "Float(-10000, 10000, 1, 2)",
      "defaultValue": "0"
    },
    {
      "name": "Y Position",
      "type": "Float(-10000, 10000, 1, 2)",
      "defaultValue": "0"
    },
    {
      "name": "Alpha",
      "type": "Float(0, 1, 0.01, 2)",
      "defaultValue": "1"
    },
    {
      "name": "Move Mode",
      "type": "DropDown('Dont Move','Absolute', 'Relative')",
      "defaultValue": "Dont Move"
    },
    {
      "name": "Tween?",
      "type": "Bool",
      "defaultValue": "false"
    },
    {
      "name": "Tween Time",
      "type": "Float(0, 100, 0.1, 2)",
      "defaultValue": "1"
    },
    {
      "name": "Tween Type",
      "type": "DropDown(['CLASSIC', 'linear', 'back', 'bounce', 'circ', 'cube', 'elastic', 'expo', 'quad', 'quart', 'quint', 'sine', 'smoothStep', 'smootherStep'])",
      "defaultValue": "CLASSIC"
    },
    {
      "name": "Tween Direction",
      "type": "DropDown(['In', 'Out', 'InOut'])",
      "defaultValue": "In"
    },
    {
      "name": "Flip X",
      "type": "Bool",
      "defaultValue": "false"
    },
    {
      "name": "Flip Y",
      "type": "Bool",
      "defaultValue": "false"
    },
    {
      "name": "Angle",
      "type": "Float(-360, 360, 1, 2)",
      "defaultValue": "0"
    }
  ]
}________PACKSEP________